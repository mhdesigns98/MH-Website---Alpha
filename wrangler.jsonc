{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mh-website",
	// Personal Cloudflare account only (wrangler profile "personal")
	"account_id": "838eca9efa4f66d164c7ff79a7f37263",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mh-website",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "mh-website-media",
		},
	],
	// Sandboxed plugins need Worker Loader, which is Workers Paid only.
	// "worker_loaders": [{ "binding": "LOADER" }],
	"triggers": {
		"crons": ["* * * * *"],
	},
}
