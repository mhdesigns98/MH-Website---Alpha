      {
        "id": "richmond-diocese-revamp",
        "slug": "richmond-diocese-revamp",
        "status": "published",
        "data": {
          "title": "Catholic Diocese of Richmond — Homepage Revamp",
          "tagline": "A modern editorial redesign of a diocesan homepage, balancing institutional gravity with a warmer, more navigable digital experience.",
          "description": "A homepage redesign concept for the Catholic Diocese of Richmond — reworking an aging institutional site into a warmer, editorial layout with a clearer information hierarchy for parishes, schools, news, and giving.",
          "category": "Web Design",
          "tags": "Web Design, Editorial, Redesign, Nonprofit",
          "project_status": "Concept",
          "featured": true,
          "order": 5,
          "accent": "#7B2D8B",
          "protected": false,
          "content": [
            {
              "_type": "block",
              "_key": "k1",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k0",
                  "text": "The Challenge",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k3",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k2",
                  "text": "The original diocesan site leaned heavily on dense navigation and dated visual conventions, making it hard for parishioners to quickly find parishes, Mass times, news, or ways to give. The goal was a full homepage revamp that felt trustworthy and editorial rather than institutional and cluttered.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k5",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k4",
                  "text": "The Approach",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k7",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k6",
                  "text": "A deep purple and gold palette paired with serif display type (Playfair Display) to signal tradition without feeling stuffy",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k9",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k8",
                  "text": "A hero section built around a single clear call to action — the diocesan pilgrimage — rather than competing banners",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "kb",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "ka",
                  "text": "A quick-links strip surfacing the four tasks visitors need most: find a parish, check Mass times, contact the diocese, and victim assistance resources",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "kd",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "kc",
                  "text": "A featured-cards section and a two-column news + sidebar layout to separate announcements from evergreen resources like parish search and the diocesan newspaper",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "kf",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "ke",
                  "text": "What I Focused On",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "kh",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "kg",
                  "text": "Legibility and hierarchy — making sure a first-time visitor (often searching for Mass times or a specific parish) can get there in one click, while still giving the diocese room for editorial storytelling and fundraising asks.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "kk",
              "style": "normal",
              "markDefs": [
                {
                  "_key": "ki",
                  "_type": "link",
                  "href": "/demos/richmond-diocese-revamp/"
                }
              ],
              "children": [
                {
                  "_type": "span",
                  "_key": "kj",
                  "text": "View the live demo →",
                  "marks": [
                    "ki"
                  ]
                }
              ]
            }
          ]
        }
