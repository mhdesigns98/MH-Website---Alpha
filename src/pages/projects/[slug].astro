---
import { decodeSlug, getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { safeEqual, splitTags, statusClass, unlockCookieName, unlockToken } from '../../lib/projects';

// Only a rendered project gets cached. A cached 404 redirect would hide a
// project for the cache lifetime after it's published.
const uncached = (response: Response) => {
  Astro.cache?.set(false);
  return response;
};

const slug = decodeSlug(Astro.params.slug);
if (!slug) return uncached(Astro.redirect('/404'));

const { entry: project, error, cacheHint } = await getEmDashEntry('projects', slug);
if (error) return uncached(new Response('Could not load the project', { status: 500 }));
if (!project) return uncached(Astro.redirect('/404'));

const {
  title,
  tagline,
  description,
  category,
  project_status: status,
  url,
  accent = '#00d9ff',
  protected: isProtected,
  access_password: password,
} = project.data;
const tags = splitTags(project.data.tags);

// Locked projects: check the unlock cookie, or the submitted password.
let locked = false;
let gateError = '';
if (isProtected) {
  // Responses vary per visitor, so they must never be cached or indexed.
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.cache?.set(false);
  const cookieName = unlockCookieName(slug);

  if (!password) {
    // Protected but no password set yet: stay locked rather than open.
    locked = true;
  } else {
    const expected = await unlockToken(slug, password);
    const cookie = Astro.cookies.get(cookieName)?.value;
    locked = !(cookie && (await safeEqual(cookie, expected)));

    if (locked && Astro.request.method === 'POST') {
      const form = await Astro.request.formData();
      const attempt = String(form.get('password') ?? '');
      if (await safeEqual(attempt, password)) {
        Astro.cookies.set(cookieName, expected, {
          path: `/projects/${slug}`,
          httpOnly: true,
          secure: Astro.url.protocol === 'https:',
          sameSite: 'lax',
          maxAge: 60 * 60 * 24 * 30,
        });
        return uncached(Astro.redirect(`/projects/${slug}`, 303));
      }
      gateError = 'Incorrect password.';
      Astro.response.status = 401;
    }
  }
} else if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
}

const safeUrl = (() => {
  if (!url) return undefined;
  try {
    const parsed = new URL(url);
    return parsed.protocol === 'https:' || parsed.protocol === 'http:' ? parsed.href : undefined;
  } catch {
    return undefined;
  }
})();
---

<Layout
  title={locked ? 'Private project — MH Designs' : `${title} — MH Designs`}
  description={locked ? 'This project is private.' : (description ?? tagline)}
  type="article"
  content={locked ? undefined : { collection: 'projects', id: project.data.id, slug }}
  noindex={isProtected}
>
  <Header />

  {locked ? (
    <div id="password-gate">
      <div class="gate-card">
        <div class="gate-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h1 class="gate-title">Password required</h1>
        <p>This project is private. Enter the password to view it.</p>
        <form id="gate-form" method="post">
          <label for="gate-input" class="visually-hidden">Password</label>
          <input
            id="gate-input"
            name="password"
            type="password"
            placeholder="Password"
            autocomplete="current-password"
            required
            autofocus
          />
          <button type="submit">Unlock</button>
        </form>
        <p id="gate-error" class="gate-error" aria-live="polite">{gateError}</p>
        <a href="/#work" class="gate-back">← Back to work</a>
      </div>
    </div>
  ) : (
    <main id="project-content">
      <article>
        <div class="project-hero" style={`--project-accent: ${accent};`}>
          <div class="container">
            <div class="back-link">
              <a href="/#work">← Back to work</a>
            </div>

            <div class="meta">
              <span class="category" {...project.edit.category}>{category}</span>
              <span class={`badge ${statusClass(status)}`}>{status}</span>
            </div>

            <h1 {...project.edit.title}>{title}</h1>
            <p class="tagline" {...project.edit.tagline}>{tagline}</p>

            <div class="tags">
              {tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>

            {safeUrl && (
              <a href={safeUrl} target="_blank" rel="noopener" class="visit-btn">
                Visit site →
              </a>
            )}
          </div>
          <div class="hero-glow" aria-hidden="true"></div>
        </div>

        <div class="container prose-container">
          <div class="prose" {...project.edit.content}>
            {project.data.content && <PortableText value={project.data.content} />}
          </div>
        </div>
      </article>
    </main>
  )}
  <Footer />
</Layout>

<style>
  /* Hero */
  .project-hero {
    position: relative;
    padding: 4rem 0 3.5rem;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: var(--project-accent, var(--accent));
    filter: blur(100px);
    opacity: 0.08;
    pointer-events: none;
  }

  .project-hero .container { position: relative; z-index: 1; }

  .back-link {
    margin-bottom: 2rem;
  }
  .back-link a {
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    transition: color var(--transition);
  }
  .back-link a:hover { color: var(--text); }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .category {
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 0.75rem;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .tag {
    font-size: 0.75rem;
    font-family: var(--font-head);
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    border: 1px solid var(--border);
  }

  .visit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    background: var(--project-accent, var(--accent));
    color: var(--bg);
    transition: box-shadow var(--transition);
  }
  .visit-btn:hover {
    box-shadow: 0 0 24px color-mix(in srgb, var(--project-accent, var(--accent)) 40%, transparent);
  }

  /* Prose */
  .prose-container {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .prose {
    max-width: 680px;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .prose :global(p) {
    color: var(--muted);
    line-height: 1.85;
    margin-bottom: 1.25rem;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose :global(li) {
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 0.4rem;
  }
  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(code) {
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: var(--surface-2);
    color: var(--accent);
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  /* Password gate */
  #password-gate {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .gate-card {
    width: 100%;
    max-width: 400px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .gate-icon {
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .gate-card .gate-title {
    font-size: 1.4rem;
    margin: 0;
  }

  .gate-card > p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }

  #gate-form {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.75rem;
  }

  #gate-input {
    flex: 1;
    padding: 0.6rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
  }
  #gate-input:focus { border-color: var(--accent); }

  #gate-form button {
    padding: 0.6rem 1.25rem;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: var(--radius-lg);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  #gate-form button:hover { opacity: 0.85; }

  .gate-error {
    color: #f43f5e;
    font-size: 0.8rem;
    min-height: 1em;
    margin: 0;
  }
  .gate-back {
    margin-top: 0.5rem;
    font-family: var(--font-head);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .gate-back:hover { color: var(--text); }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
