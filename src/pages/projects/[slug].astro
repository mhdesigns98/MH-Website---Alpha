---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, tagline, description, category, tags, status, url, accent, protected: isProtected, passwordHash } = project.data;

const statusClass = {
  'Live': 'live',
  'In Progress': 'progress',
  'Concept': 'concept',
}[status] ?? 'concept';
---

<Layout title={`${title} — MH Designs`} description={description}>
  <Header />

  {isProtected && (
    <div id="password-gate" data-hash={passwordHash} data-slug={project.slug}>
      <div class="gate-card">
        <div class="gate-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h2>Password required</h2>
        <p>This project is private. Enter the password to view it.</p>
        <form id="gate-form">
          <input
            id="gate-input"
            type="password"
            placeholder="Password"
            autocomplete="current-password"
            required
          />
          <button type="submit">Unlock</button>
        </form>
        <p id="gate-error" class="gate-error" aria-live="polite"></p>
      </div>
    </div>
  )}

  <main id="project-content" style={isProtected ? 'display:none' : ''}>
    <article>
      <div class="project-hero" style={`--project-accent: ${accent};`}>
        <div class="container">
          <div class="back-link">
            <a href="/#work">← Back to work</a>
          </div>

          <div class="meta">
            <span class="category">{category}</span>
            <span class={`badge ${statusClass}`}>{status}</span>
          </div>

          <h1>{title}</h1>
          <p class="tagline">{tagline}</p>

          <div class="tags">
            {tags.map(tag => <span class="tag">{tag}</span>)}
          </div>

          {url && (
            <a href={url} target="_blank" rel="noopener" class="visit-btn">
              Visit site →
            </a>
          )}
        </div>
        <div class="hero-glow" aria-hidden="true"></div>
      </div>

      <div class="container prose-container">
        <div class="prose">
          <Content />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  /* Hero */
  .project-hero {
    position: relative;
    padding: 4rem 0 3.5rem;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: var(--project-accent, var(--accent));
    filter: blur(100px);
    opacity: 0.08;
    pointer-events: none;
  }

  .project-hero .container { position: relative; z-index: 1; }

  .back-link {
    margin-bottom: 2rem;
  }
  .back-link a {
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    transition: color var(--transition);
  }
  .back-link a:hover { color: var(--text); }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .category {
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 0.75rem;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .tag {
    font-size: 0.75rem;
    font-family: var(--font-head);
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    border: 1px solid var(--border);
  }

  .visit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    background: var(--project-accent, var(--accent));
    color: var(--bg);
    transition: box-shadow var(--transition);
  }
  .visit-btn:hover {
    box-shadow: 0 0 24px color-mix(in srgb, var(--project-accent, var(--accent)) 40%, transparent);
  }

  /* Prose */
  .prose-container {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .prose {
    max-width: 680px;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .prose :global(p) {
    color: var(--muted);
    line-height: 1.85;
    margin-bottom: 1.25rem;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose :global(li) {
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 0.4rem;
  }
  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(code) {
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: var(--surface-2);
    color: var(--accent);
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  /* Password gate */
  #password-gate {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .gate-card {
    width: 100%;
    max-width: 400px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .gate-icon {
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .gate-card h2 {
    font-size: 1.4rem;
    margin: 0;
  }

  .gate-card > p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }

  #gate-form {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.75rem;
  }

  #gate-input {
    flex: 1;
    padding: 0.6rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
  }
  #gate-input:focus { border-color: var(--accent); }

  #gate-form button {
    padding: 0.6rem 1.25rem;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: var(--radius-lg);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  #gate-form button:hover { opacity: 0.85; }

  .gate-error {
    color: #f43f5e;
    font-size: 0.8rem;
    min-height: 1em;
    margin: 0;
  }
</style>

{isProtected && (
  <script is:inline>
    (function () {
      const gate = document.getElementById('password-gate');
      const content = document.getElementById('project-content');
      if (!gate) return;

      const slug = gate.dataset.slug;
      const storedHash = gate.dataset.hash;
      const sessionKey = `unlocked-${slug}`;

      async function sha256(str) {
        const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
        return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
      }

      function unlock() {
        gate.style.display = 'none';
        content.style.display = '';
        sessionStorage.setItem(sessionKey, '1');
      }

      if (sessionStorage.getItem(sessionKey) === '1') {
        unlock();
        return;
      }

      document.getElementById('gate-form').addEventListener('submit', async function (e) {
        e.preventDefault();
        const input = document.getElementById('gate-input').value;
        const hash = await sha256(input);
        if (hash === storedHash) {
          unlock();
        } else {
          document.getElementById('gate-error').textContent = 'Incorrect password.';
          document.getElementById('gate-input').value = '';
          document.getElementById('gate-input').focus();
        }
      });
    })();
  </script>
)}
