---
import { storyblokEditable, renderRichText } from '@storyblok/astro';

const { blok } = Astro.props;
const tags = (blok.tags ?? '').split(',').map((t: string) => t.trim()).filter(Boolean);
const bodyHtml = renderRichText(blok.body);

const statusClass = {
  'Live': 'live',
  'In Progress': 'progress',
  'Concept': 'concept',
}[blok.status as string] ?? 'concept';
---

<article {...storyblokEditable(blok)}>
  <div class="project-hero" style={`--project-accent: ${blok.accent};`}>
    <div class="container">
      <div class="back-link">
        <a href="/#work">← Back to work</a>
      </div>

      <div class="meta">
        <span class="category">{blok.category}</span>
        <span class={`badge ${statusClass}`}>{blok.status}</span>
      </div>

      <h1>{blok.title}</h1>
      <p class="tagline">{blok.tagline}</p>

      <div class="tags">
        {tags.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>

      {blok.url && (
        <a href={blok.url} target="_blank" rel="noopener" class="visit-btn">
          Visit site →
        </a>
      )}
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
  </div>

  <div class="container prose-container">
    <div class="prose" set:html={bodyHtml} />
  </div>
</article>

<style>
  /* Hero */
  .project-hero {
    position: relative;
    padding: 4rem 0 3.5rem;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: var(--project-accent, var(--accent));
    filter: blur(100px);
    opacity: 0.08;
    pointer-events: none;
  }

  .project-hero .container { position: relative; z-index: 1; }

  .back-link {
    margin-bottom: 2rem;
  }
  .back-link a {
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    transition: color var(--transition);
  }
  .back-link a:hover { color: var(--text); }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .category {
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 0.75rem;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .tag {
    font-size: 0.75rem;
    font-family: var(--font-head);
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    border: 1px solid var(--border);
  }

  .visit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    background: var(--project-accent, var(--accent));
    color: var(--bg);
    transition: box-shadow var(--transition);
  }
  .visit-btn:hover {
    box-shadow: 0 0 24px color-mix(in srgb, var(--project-accent, var(--accent)) 40%, transparent);
  }

  /* Prose */
  .prose-container {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .prose {
    max-width: 680px;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .prose :global(p) {
    color: var(--muted);
    line-height: 1.85;
    margin-bottom: 1.25rem;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose :global(li) {
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 0.4rem;
  }
  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(code) {
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: var(--surface-2);
    color: var(--accent);
    font-family: 'SF Mono', 'Fira Code', monospace;
  }
</style>
